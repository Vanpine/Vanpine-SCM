# ==================== SRM AI Service 环境变量模板 ====================
# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，切勿提交真实密钥。

# ---------- Embedding API（硅基流动 / OpenAI 兼容） ----------
# 必填：Embedding API 密钥
EMBEDDING_API_KEY=
# 选填：Embedding API 地址，默认硅基流动
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# 选填：Embedding 模型名称
EMBEDDING_MODEL=BAAI/bge-m3
# 选填：向量维度，需与模型匹配（bge-m3 = 1024）
EMBEDDING_VECTOR_DIM=1024

# ---------- Milvus 向量数据库 ----------
# 必填：Milvus 服务地址与端口，生产建议内网地址
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# 知识库分块集合（dense + 原生 BM25 混合检索，需 Milvus ≥2.5）
# 旧集合 ai_doc_chunks 为 dense-only，改此项并重新解析全部文档即可平滑切换
DOC_COLLECTION_NAME=ai_doc_chunks_v2
# BM25 精确命中保送条数：RRF 会奖励「两路都出现」，可能把只在关键词路排第一的
# 编号/专有名词挤出候选窗口；单独取 BM25 前 N 名强制并入（0=关闭）
HYBRID_KEYWORD_GUARANTEE=3

# ---------- DeepSeek 大模型 ----------
# 必填：DeepSeek API 密钥
DEEPSEEK_API_KEY=

# ---------- PDF 解析 ----------
# 深解析开关（pdfplumber 字号标题 + 表格），默认关闭走纯 pypdf
PDF_DEEP_PARSE=false
# 单文档解析页数上限
PDF_MAX_PAGES=200

# ---------- 扫描件 OCR（多模态模型） ----------
# 扫描页渲染成图片后交多模态模型转 Markdown；默认复用 DeepSeek 配置
VLM_ENABLED=true
# 模型名（deepseek-flash 已支持图片输入）
VLM_MODEL=deepseek-flash
# OpenAI 兼容地址；留空则复用 DEEPSEEK_BASE_URL
VLM_BASE_URL=
# 密钥；留空则复用 DEEPSEEK_API_KEY
VLM_API_KEY=
# 页面渲染 DPI（200~300，越高越清晰也越慢）
VLM_DPI=200
# 单页超时秒数
VLM_TIMEOUT=120
# 单页输出 token 上限
VLM_MAX_TOKENS=4096
# 并发 OCR 页数（过高易被限流）
VLM_CONCURRENCY=3
# 单文档最多 OCR 页数：Java 侧同步读超时 120s，超限提示分册上传
VLM_MAX_PAGES=20
# OCR 结果低于此字符数视为失败
VLM_MIN_CHARS=20
# OCR 质量分阈值：低于 FAIL 重试/判失败；低于 WARN 入库但提示人工核对
VLM_QUALITY_FAIL=0.35
VLM_QUALITY_WARN=0.65

# ---------- Rerank（交叉编码器重排，失败自动回退原序） ----------
# 开关（默认开；无 Key 时自动跳过）
RERANK_ENABLED=true
# 重排模型
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 超时秒数（失败即回退，不拖垮问答）
RERANK_TIMEOUT=8
# 初召回进入重排的候选上限
RERANK_MAX_CANDIDATES=20
# 置信度阈值：rerank 分数低于此值的块丢弃，不注入 Prompt
# 注意 bge-reranker-v2-m3 分数量级偏低（相关查询常 0.1~0.2），勿设 0.3（会全空）
RERANK_SCORE_THRESHOLD=0.05

# ---------- 批量 Embedding ----------
# 单次批大小
EMBEDDING_BATCH_SIZE=16

# ---------- Java 内部接口（父块回查，parent-child 回填） ----------
# gsc-service-ai 内部接口地址（直连端口，不走网关）
AI_PARENTS_API_URL=http://127.0.0.1:3085/internal/ai/parents
# 父块回查超时（秒），失败回退子块原文
AI_PARENTS_TIMEOUT=5

# ---------- LangSmith 链路追踪 ----------
# 开关：true 时 ChatOpenAI 的每次调用都会上报一条 trace
LANGSMITH_TRACING=false
# 必填：LangSmith API 密钥
LANGSMITH_API_KEY=
# 选填：上报地址，默认美区；欧洲区改为 https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 选填：追踪项目名，不填则落到 default
LANGSMITH_PROJECT=srm-ai-service

