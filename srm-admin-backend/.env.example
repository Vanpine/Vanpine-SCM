# 后端环境变量模板
# 使用方式：复制到部署环境，或通过 Nacos / systemd EnvironmentFile 注入
# 仓库中不保存任何真实凭据，请勿把填好的文件提交到版本库

# ---------- Nacos 注册 / 配置中心 ----------
NACOS_ADDR=填写自己的:8848
NACOS_NAMESPACE=dev
NACOS_USERNAME=nacos
NACOS_PASSWORD=changeme

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gsc
MYSQL_USERNAME=root
MYSQL_PASSWORD=changeme

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# ---------- RabbitMQ ----------
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=changeme

# ---------- 安全 ----------
# JWT 签名密钥，生产必须使用高强度随机值
JWT_SECRET=changeme
# 内部接口（/internal/**）调用密钥
INTERNAL_SECRET=changeme

# ---------- AI 服务 ----------
AI_SERVICE_URL=http://127.0.0.1:8100
AI_SERVICE_TOKEN=changeme

# ---------- 阿里云 OSS ----------
ALIYUN_ACCESS_KEY_ID=changeme
ALIYUN_ACCESS_KEY_SECRET=changeme
OSS_BUCKET=changeme
OSS_ENDPOINT=oss-cn-<region>.aliyuncs.com
OSS_CUSTOM_DOMAIN=

# ---------- 外部服务 ----------
PASSPORT_API_BASE=
PASSPORT_CLIENT_ID=
PASSPORT_CLIENT_SECRET=
LAW_FIRM_API_BASE=

# ---------- 运行参数 ----------
# 雪花 ID workerId，多实例部署时必须唯一
GSC_WORKER_ID=1
GSC_MATCH_ENGINE=
GSC_CORS_ALLOWED_ORIGINS=
GSC_PAYMENT_NOTIFY_URL=
GATEWAY_LIMIT_QPS=

# ---------- 链路追踪 ----------
GSC_ZIPKIN_ENABLED=false
ZIPKIN_ENDPOINT=http://127.0.0.1:9411/api/v2/spans
TRACING_SAMPLE_RATE=0.1
