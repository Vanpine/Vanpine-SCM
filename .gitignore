# 依赖与构建产物
node_modules/
target/
dist/
build/
out/
.next/

# 环境变量（保留 .env.example）
.env
.env.*
!.env.example

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
*.iml

# worktree 工作副本
.worktrees/

# CI 配置（不上传到仓库）
.gitlab-ci.yml

# 本地保留、不上传到仓库的官网项目
gsc-fronted/

# 毕业设计相关材料（本地保留，不纳入版本管理）
毕设/
report_assets/

